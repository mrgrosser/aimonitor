# Generate strong unique values before production use.
APP_USERNAME=admin
APP_PASSWORD=change-me-now
SESSION_SECRET=replace-with-at-least-32-random-characters
# Full Compliance Access Key enables content; Admin keys expose activities only.
ANTHROPIC_COMPLIANCE_ACCESS_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# With no API key, realistic demonstration evidence is displayed.
DEMO_MODE=true
COOKIE_SECURE=false

# Microsoft Entra ID / OpenID Connect
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8080/api/auth/entra/callback
# Optional comma-separated allowlists. A user must match at least one configured value.
ENTRA_ALLOWED_ROLES=Compliance.Reviewer,Compliance.Admin
ENTRA_ALLOWED_GROUPS=
# Retain local login for demo/emergency access until SSO has been validated.
LOCAL_AUTH_ENABLED=true

# Microsoft 365 Copilot Interaction Export (application-only Microsoft Graph).
# A separate app registration is recommended. Grant admin consent for
# AiEnterpriseInteraction.Read.All and User.ReadBasic.All.
M365_COPILOT_TENANT_ID=
M365_COPILOT_CLIENT_ID=
M365_COPILOT_CLIENT_SECRET=
# Optional comma-separated object IDs or UPNs. Leave empty to enumerate tenant users.
M365_COPILOT_USER_IDS=
M365_COPILOT_MAX_USERS=100

# Findings scoring and append-only audit ledger
RISK_FINDING_THRESHOLD=40
DATABASE_PATH=/data/jo-ai-monitor.db
# Stable keyed aliases for identities imported into usage analytics. Use a dedicated random value in production.
USAGE_ANONYMIZATION_KEY=replace-with-a-different-32-character-random-value

# Compliance reporting. Named identities are hidden unless the signed-in Entra user
# has one of these roles. Local admin is permitted for evaluation deployments.
NAMED_USER_REPORT_ROLES=Compliance.Admin,Compliance.Investigator
# Optional SMTP delivery for daily, weekly, or monthly scheduled reports.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Investigation case authorization and attachment storage.
CASE_READ_ROLES=Compliance.Admin,Compliance.Investigator,Compliance.Reviewer,Compliance.Auditor
CASE_WRITE_ROLES=Compliance.Admin,Compliance.Investigator
ATTACHMENT_PATH=/data/attachments
MAX_ATTACHMENT_MB=10
