# Generate strong unique values before production use. Live mode (DEMO_MODE=false with an
# API key) refuses to start on these published placeholders or a SESSION_SECRET under 32
# characters.
APP_USERNAME=admin
APP_PASSWORD=change-me-now
SESSION_SECRET=replace-with-at-least-32-random-characters
# Local sign-in lockout: after LOGIN_MAX_FAILURES failures inside the window, the
# IP/username pair is refused for the lockout period.
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=300
# Full Compliance Access Key enables content; Admin keys expose activities only.
ANTHROPIC_COMPLIANCE_ACCESS_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# With no API key, realistic demonstration evidence is displayed.
DEMO_MODE=true
COOKIE_SECURE=false

# Microsoft Entra ID / OpenID Connect
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8080/api/auth/entra/callback
# Optional comma-separated allowlists. A user must match at least one configured value.
ENTRA_ALLOWED_ROLES=Compliance.Reviewer,Compliance.Investigator,Compliance.Auditor,Compliance.ReportReader,Compliance.ReportsOnly,Compliance.UsageReader,Compliance.Admin
ENTRA_ALLOWED_GROUPS=
# Retain local login for demo/emergency access until SSO has been validated.
LOCAL_AUTH_ENABLED=true

# Microsoft 365 Copilot Interaction Export (application-only Microsoft Graph).
# A separate app registration is recommended. Grant admin consent for
# AiEnterpriseInteraction.Read.All and User.ReadBasic.All.
M365_COPILOT_TENANT_ID=
M365_COPILOT_CLIENT_ID=
M365_COPILOT_CLIENT_SECRET=
# Optional comma-separated object IDs or UPNs. Leave empty to enumerate tenant users.
M365_COPILOT_USER_IDS=
M365_COPILOT_MAX_USERS=100

# Findings scoring and append-only audit ledger
RISK_FINDING_THRESHOLD=40
DATABASE_PATH=/data/jo-ai-monitor.db
# Durable findings (live mode): a background job syncs providers with pagination and stores
# promoted evidence. Retention prunes promoted evidence after this many days (0 disables);
# case snapshots and legal holds are never pruned. Suppressed items stay metadata-only.
FINDINGS_SYNC_INTERVAL_SECONDS=300
FINDINGS_SYNC_MAX_ITEMS=2000
FINDING_RETENTION_DAYS=180
# Stable keyed aliases for identities imported into usage analytics. Use a dedicated random value in production.
USAGE_ANONYMIZATION_KEY=replace-with-a-different-32-character-random-value

# Compliance reporting. Named identities are hidden unless the signed-in Entra user
# has one of these roles. Local admin is permitted for evaluation deployments.
NAMED_USER_REPORT_ROLES=Compliance.Admin,Compliance.Investigator
# Optional SMTP delivery for daily, weekly, or monthly scheduled reports.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Operational alerts. Alert notifications contain a minimal finding summary and
# link to an authorized JO AI Monitor view; they never include prompt evidence.
ALERT_EMAIL_TO=
# Use a Teams Workflow/Power Automate webhook URL for new Microsoft Teams integrations.
TEAMS_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
# Required for the generic webhook. Receivers verify X-JO-Signature-256 over the raw JSON body.
ALERT_WEBHOOK_SECRET=
ALERT_PUBLIC_URL=https://crawlerai.japsolson.app
ALERT_DELIVERY_MAX_ATTEMPTS=5
ALERT_DELIVERY_INTERVAL_SECONDS=30
# Deliveries stuck in 'processing' by a crash become claimable again after this many seconds.
ALERT_PROCESSING_STALE_SECONDS=600
# Detection thresholds for correlated and financial alerts.
ALERT_CORRELATION_WINDOW_DAYS=30
ALERT_CORRELATION_MIN_EVENTS=3
ALERT_BUDGET_PERCENT=80
ALERT_UNUSED_SEAT_MIN=1
# Zero disables the absolute run-rate alert until Finance supplies an approved limit.
ALERT_MONTHLY_RUN_RATE_LIMIT_USD=0
ALERT_MODEL_SPEND_SHARE_PERCENT=40
ALERT_MODEL_REQUEST_SHARE_MAX_PERCENT=20

# Rapid7 InsightIDR Custom Logs webhook. Keep the unique URL in deployment
# secrets; administrators enable forwarding and select allowed fields in Settings.
RAPID7_WEBHOOK_URL=
RAPID7_MAX_ATTEMPTS=8
RAPID7_PROCESSING_STALE_SECONDS=600

# Investigation case authorization and attachment storage.
CASE_READ_ROLES=Compliance.Admin,Compliance.Investigator,Compliance.Reviewer,Compliance.Auditor
CASE_WRITE_ROLES=Compliance.Admin,Compliance.Investigator
# Page-level Entra application roles. Compliance.ReportsOnly is intentionally
# limited to the Reports page and its APIs. Override any list as policy requires.
PAGE_EVIDENCE_ROLES=Compliance.Admin,Compliance.Investigator,Compliance.Reviewer
PAGE_CASES_ROLES=Compliance.Admin,Compliance.Investigator,Compliance.Reviewer,Compliance.Auditor
PAGE_ACTIVITY_ROLES=Compliance.Admin,Compliance.Investigator,Compliance.Reviewer,Compliance.Auditor
PAGE_USAGE_ROLES=Compliance.Admin,Compliance.UsageReader
PAGE_REPORTS_ROLES=Compliance.Admin,Compliance.ReportReader,Compliance.ReportsOnly,Compliance.Investigator,Compliance.Reviewer,Compliance.Auditor
PAGE_DIRECTORY_ROLES=Compliance.Admin,Compliance.Investigator,Compliance.Reviewer
PAGE_AUDIT_ROLES=Compliance.Admin,Compliance.Auditor
PAGE_SETTINGS_ROLES=Compliance.Admin
USAGE_USER_DETAIL_ROLES=Compliance.Admin,Compliance.UsageReader
ATTACHMENT_PATH=/data/attachments
MAX_ATTACHMENT_MB=10
