# Generate strong unique values before production use.
APP_USERNAME=admin
APP_PASSWORD=change-me-now
SESSION_SECRET=replace-with-at-least-32-random-characters
# Full Compliance Access Key enables content; Admin keys expose activities only.
ANTHROPIC_COMPLIANCE_ACCESS_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# With no API key, realistic demonstration evidence is displayed.
DEMO_MODE=true
COOKIE_SECURE=false

# Microsoft Entra ID / OpenID Connect
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8080/api/auth/entra/callback
# Optional comma-separated allowlists. A user must match at least one configured value.
ENTRA_ALLOWED_ROLES=Compliance.Reviewer,Compliance.Admin
ENTRA_ALLOWED_GROUPS=
# Retain local login for demo/emergency access until SSO has been validated.
LOCAL_AUTH_ENABLED=true
